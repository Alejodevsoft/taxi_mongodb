[
  {
    "id": "01_conteo",
    "titulo": "Conteo y documento de ejemplo",
    "codigo": "({viajes:db.viajes.countDocuments(),zonas:db.zonas.countDocuments(),\nejemplo:db.viajes.findOne({_id:'tlc_202501_00001'})})"
  },
  {
    "id": "02_insertar",
    "titulo": "Inserción de un documento de demostración",
    "codigo": "db.viajes.insertOne({_id:'demo_crud_t4',\nfecha_inicio:ISODate('2025-01-01T15:00:00Z'),fecha_fin:ISODate('2025-01-01T15:10:00Z'),\nzona_origen_id:236,zona_destino_id:237,distancia_millas:2.5,duracion_min:10,\nimporte_centavos:2000,moneda:'USD',estado_revision:'pendiente',es_demo:true})"
  },
  {
    "id": "03_seleccionar",
    "titulo": "Selección por identificador",
    "codigo": "db.viajes.find({_id:'demo_crud_t4'},\n{fecha_inicio:1,importe_centavos:1,estado_revision:1}).toArray()"
  },
  {
    "id": "04_actualizar",
    "titulo": "Actualización y comprobación",
    "codigo": "(()=>{const cambio=db.viajes.updateOne({_id:'demo_crud_t4'},\n{$set:{estado_revision:'verificado'}});\nreturn {cambio,documento:db.viajes.findOne({_id:'demo_crud_t4'},\n{estado_revision:1,importe_centavos:1})};})()"
  },
  {
    "id": "05_eliminar",
    "titulo": "Eliminación acotada al documento de demostración",
    "codigo": "(()=>{const eliminacion=db.viajes.deleteOne({_id:'demo_crud_t4',es_demo:true});\nreturn {eliminacion,restantes_demo:db.viajes.countDocuments({_id:'demo_crud_t4'}),\nviajes_originales:db.viajes.countDocuments()};})()"
  },
  {
    "id": "06_filtros",
    "titulo": "Filtros con operadores y ordenamiento",
    "codigo": "db.viajes.find({importe_centavos:{$gte:3000},\nduracion_min:{$gte:10,$lte:60},zona_origen_id:{$in:[132,138,236,237]}},\n{_id:1,zona_origen_id:1,duracion_min:1,importe_centavos:1})\n.sort({importe_centavos:-1,_id:1}).limit(5).toArray()"
  },
  {
    "id": "07_fechas",
    "titulo": "Filtro por fechas BSON Date",
    "codigo": "({cantidad:db.viajes.countDocuments({fecha_inicio:{\n$gte:ISODate('2025-01-01T05:00:00Z'),$lt:ISODate('2025-01-02T05:00:00Z')}}),\nprimeros:db.viajes.find({fecha_inicio:{$gte:ISODate('2025-01-01T05:00:00Z'),\n$lt:ISODate('2025-01-02T05:00:00Z')}},{fecha_inicio:1}).sort({fecha_inicio:1,_id:1}).limit(3).toArray()})"
  },
  {
    "id": "08_lookup",
    "titulo": "Unión de viajes con el catálogo de zonas",
    "codigo": "db.viajes.aggregate([\n{$sort:{_id:1}},{$limit:3},\n{$lookup:{from:'zonas',localField:'zona_origen_id',foreignField:'_id',as:'origen'}},\n{$lookup:{from:'zonas',localField:'zona_destino_id',foreignField:'_id',as:'destino'}},\n{$project:{_id:1,origen:{$arrayElemAt:['$origen.nombre',0]},\ndestino:{$arrayElemAt:['$destino.nombre',0]},importe_usd:{$divide:['$importe_centavos',100]}}}\n]).toArray()"
  },
  {
    "id": "09_agregacion",
    "titulo": "Conteo suma y promedio generales",
    "codigo": "db.viajes.aggregate([\n{$group:{_id:null,viajes:{$sum:1},total_centavos:{$sum:'$importe_centavos'},\npromedio_centavos:{$avg:'$importe_centavos'},duracion_promedio_min:{$avg:'$duracion_min'}}},\n{$project:{_id:0,viajes:1,total_centavos:1,total_usd:{$divide:['$total_centavos',100]},\npromedio_usd:{$round:[{$divide:['$promedio_centavos',100]},2]},\nduracion_promedio_min:{$round:['$duracion_promedio_min',2]}}}\n]).toArray()"
  },
  {
    "id": "10_por_zona",
    "titulo": "Estadísticas por zona de origen",
    "codigo": "db.viajes.aggregate([\n{$group:{_id:'$zona_origen_id',viajes:{$sum:1},total_centavos:{$sum:'$importe_centavos'},\npromedio_centavos:{$avg:'$importe_centavos'}}},\n{$sort:{viajes:-1,_id:1}},{$limit:5},\n{$lookup:{from:'zonas',localField:'_id',foreignField:'_id',as:'zona'}},\n{$project:{_id:0,zona_id:'$_id',zona:{$arrayElemAt:['$zona.nombre',0]},viajes:1,\ntotal_usd:{$divide:['$total_centavos',100]},\npromedio_usd:{$round:[{$divide:['$promedio_centavos',100]},2]}}}\n]).toArray()"
  },
  {
    "id": "11_integridad",
    "titulo": "Tipos y relaciones del conjunto cargado",
    "codigo": "({fechas_date:db.viajes.countDocuments({fecha_inicio:{$type:'date'}}),\nsin_origen:db.viajes.aggregate([\n{$lookup:{from:'zonas',localField:'zona_origen_id',foreignField:'_id',as:'z'}},\n{$match:{z:{$size:0}}},{$count:'cantidad'}]).toArray(),\nsin_destino:db.viajes.aggregate([\n{$lookup:{from:'zonas',localField:'zona_destino_id',foreignField:'_id',as:'z'}},\n{$match:{z:{$size:0}}},{$count:'cantidad'}]).toArray()})"
  },
  {
    "id": "12_indice",
    "titulo": "Comprobación del índice compuesto",
    "codigo": "(()=>{const e=db.viajes.find({zona_origen_id:236,\nfecha_inicio:{$gte:ISODate('2025-01-01T05:00:00Z')}})\n.hint('origen_fecha').explain('executionStats');\nreturn {indice_solicitado:'origen_fecha',plan:e.queryPlanner.winningPlan,\ndevueltos:e.executionStats.nReturned,documentos_examinados:e.executionStats.totalDocsExamined,\nclaves_examinadas:e.executionStats.totalKeysExamined};})()"
  }
]